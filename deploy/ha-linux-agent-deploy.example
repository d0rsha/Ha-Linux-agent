# Repository checkout used by deploy/update.sh.
DEPLOY_ROOT=/opt/ha-linux-agent
DEPLOY_BRANCH=main

# Optional space-separated list of long-running Compose services to deploy.
# Leave empty to run the normal Compose project (including any profiles enabled
# through COMPOSE_PROFILES in the repository-local .env file).
# Example:
# DEPLOY_SERVICES="ha-agent-telegram openai-mcp-tunnel"
DEPLOY_SERVICES=
