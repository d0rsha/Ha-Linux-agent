[Unit]
Description=Update HA Linux Agent from GitHub and GHCR
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/ha-linux-agent-deploy
ExecStart=/usr/bin/bash /opt/ha-linux-agent/deploy/update.sh
TimeoutStartSec=10min
