# Home Assistant MCP endpoint. Prefer a LAN/VPN address from this Linux server.
HA_MCP_URL=http://192.168.x.x:8123/api/mcp/assist
HA_TOKEN=replace-with-a-home-assistant-long-lived-access-token
# Optional override for REST/WebSocket history and notifications. Normally derived from HA_MCP_URL.
# HA_BASE_URL=http://192.168.x.x:8123

# LLM provider: openai | openrouter | openai-compatible
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_API_KEY=replace-me
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_STYLE=responses

# Backward-compatible v0.1 variables still work for the OpenAI provider:
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=gpt-5.4-mini
# OpenRouter can also use OPENROUTER_API_KEY instead of LLM_API_KEY.

# Agent behavior
MAX_TOOL_ROUNDS=8

# Home Assistant native history/statistics (v0.3)
HA_HISTORY_ENABLED=true
HA_HISTORY_MAX_ENTITIES=5
HA_HISTORY_MAX_DAYS=14
HA_STATISTICS_MAX_DAYS=3650
HA_HISTORY_MAX_POINTS=2000

# Home Assistant write policy. Keep false until HA MCP "Control Home Assistant" is enabled.
HA_WRITE_ENABLED=false

# Exact MCP tool names. Discover names with: ha-agent tools
HA_SAFE_WRITE_TOOLS=
HA_SENSITIVE_WRITE_TOOLS=
HA_ADMIN_TOOLS=

# Conservative read classification. Unknown tools are blocked from the LLM.
HA_READ_TOOL_PREFIXES=Get,List,Read,Search,Query,Fetch,Check
HA_READ_TOOLS=HassTimerStatus

# A safe-write tool is elevated to confirmation-required when its arguments match these.
HA_SENSITIVE_DOMAINS=lock,alarm_control_panel
HA_SENSITIVE_NAME_TERMS=lock,alarm,garage,front door,back door

# Scheduled reports (v0.4)
REPORT_PROMPT_PATH=prompts/house_health.md
REPORT_LOCK_PATH=/data/report.lock
REPORT_TIMEOUT_SECONDS=180
REPORT_RETRIES=1
# Home Assistant notify service, e.g. ALL_DEVICES or mobile_app_my_phone. Blank = stdout only.
REPORT_NOTIFY_SERVICE=
REPORT_TITLE=Morning house health
REPORT_ANOMALY_TITLE=House anomaly

# Telegram persistent chat (v0.4). Keep disabled until both values are configured.
# TELEGRAM_BOT_TOKEN=123456:replace-me
# Numeric Telegram user IDs only; unknown users receive no agent response.
TELEGRAM_ALLOWED_USERS=
CHAT_SESSION_DIR=/data/chat
CHAT_CONTEXT_MESSAGES=12
CHAT_MIN_INTERVAL_SECONDS=2
# /approve-sensitive grants one sensitive tool call for the next request within this TTL.
CHAT_SENSITIVE_APPROVAL_TTL_SECONDS=120

# Restricted Linux host diagnostics (v0.5). Cheap /proc tools are enabled by default.
HOST_DIAGNOSTICS_ENABLED=true
HOST_PROC_ROOT=/proc
HOST_DISK_PATHS=/

# Optional remote host MCP endpoints. Use only on LAN/VPN/Tailscale.
HOST_MCP_URLS=
HOST_MCP_TOKEN=
HOST_MCP_BIND=127.0.0.1
HOST_MCP_PORT=8750

# Host diagnostics allowlists. Empty allowlists mean the corresponding tool is unavailable.
HOST_SERVICE_ALLOWLIST=
HOST_DOCKER_SOCKET=
HOST_DOCKER_ALLOWLIST=
HOST_LOG_PATHS=
HOST_JOURNAL_UNITS=
HOST_LOG_MAX_BYTES=65536
HOST_LOG_MAX_AGE_SECONDS=3600
HOST_REACHABILITY_TARGETS=
HOST_REACHABILITY_TIMEOUT_SECONDS=3

# Optional JSONL audit log. Entries are redacted before writing.
AUDIT_LOG_PATH=/data/audit/audit.jsonl
